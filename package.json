{
  "name": "lithomemphis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:audit && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tokens:sync": "node scripts/tokens-audit.mjs --write-css",
    "tokens:audit": "node scripts/tokens-audit.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build:all": "npm run build && storybook build -o dist/storybook --quiet",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "node --experimental-strip-types --test src/lab/press-cycle/*.test.ts",
    "test:e2e": "npm run build && STORYBOOK_DISABLE_TELEMETRY=1 npm run build-storybook && playwright test"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@storybook/react-vite": "^10.6.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "oxlint": "^1.88.0",
    "storybook": "^10.6.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
